PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas Database Configuration ──────────────────────────────────────
# Replace YOUR_MONGODB_CONNECTION_STRING_HERE with your actual MongoDB Atlas URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kisanq?retryWrites=true&w=majority
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING_HERE
MONGO_URI=YOUR_MONGODB_CONNECTION_STRING_HERE

# ─── Security & Frontend Integration ───────────────────────────────────────────
JWT_SECRET=kisanq_jwt_super_secret_key_change_in_production
CLIENT_URL=http://localhost:5185
FAST2SMS_API_KEY=your_fast2sms_api_key_here
